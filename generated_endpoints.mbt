) -> SearchQuery {
  {
    allow_no_indices,
    allow_partial_search_results,
    analyzer,
    analyze_wildcard,
    batched_reduce_size,
    ccs_minimize_roundtrips,
    default_operator,
    df,
    docvalue_fields,
    expand_wildcards,
    explain,
    ignore_throttled,
    ignore_unavailable,
    include_named_queries_score,
    lenient,
