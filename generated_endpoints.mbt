///|
pub fn UpdateQuery::to_pairs(self : UpdateQuery) -> Array[(String, String)] {
  let pairs : Array[(String, String)] = []
  match self.if_primary_term {
    Some(value) =>
      push_query_json(pairs, "if_primary_term", @json.to_json(value))
    None => ()
  }
  match self.if_seq_no {
    Some(value) => push_query_json(pairs, "if_seq_no", @json.to_json(value))
    None => ()
  }
  match self.include_source_on_error {
    Some(value) =>
      push_query_json(pairs, "include_source_on_error", @json.to_json(value))
    None => ()
  }
  match self.lang {
    Some(value) => push_query_json(pairs, "lang", @json.to_json(value))
    None => ()
  }
  match self.refresh {
    Some(value) => push_query_json(pairs, "refresh", @json.to_json(value))
    None => ()
  }
  match self.require_alias {
    Some(value) => push_query_json(pairs, "require_alias", @json.to_json(value))
    None => ()
  }
  match self.retry_on_conflict {
    Some(value) =>
      push_query_json(pairs, "retry_on_conflict", @json.to_json(value))
    None => ()
  }
  match self.routing {
    Some(value) => push_query_json(pairs, "routing", @json.to_json(value))
    None => ()
  }
  match self.timeout {
    Some(value) => push_query_json(pairs, "timeout", @json.to_json(value))
    None => ()
  }
  match self.wait_for_active_shards {
    Some(value) =>
      push_query_json(pairs, "wait_for_active_shards", @json.to_json(value))
    None => ()
  }
  match self._source {
    Some(value) => push_query_json(pairs, "_source", @json.to_json(value))
    None => ()
  }
  match self._source_excludes {
    Some(value) =>
      push_query_json(pairs, "_source_excludes", @json.to_json(value))
    None => ()
  }
  match self._source_includes {
    Some(value) =>
      push_query_json(pairs, "_source_includes", @json.to_json(value))
    None => ()
  }
  pairs
}

