  match self.allow_partial_search_results {
    Some(value) => obj["allow_partial_search_results"] = @json.to_json(value)
    None => ()
  }
  match self.allow_partial_sequence_results {
    Some(value) => obj["allow_partial_sequence_results"] = @json.to_json(value)
    None => ()
  }
  match self.expand_wildcards {
    Some(value) => obj["expand_wildcards"] = @json.to_json(value)
    None => ()
