} derive(Eq, Debug)

///|
pub impl ToJson for EqlSearchQuery with fn to_json(self : EqlSearchQuery) -> Json {
  let obj : Map[String, Json] = Map([])
  match self.allow_no_indices {
    Some(value) => obj["allow_no_indices"] = @json.to_json(value)
    None => ()
